\newcommand{\CourseCover}{%
\begin{titlepage}\thispagestyle{empty}\noindent
\begin{tikzpicture}[remember picture,overlay]
  \fill[CourseNavy] (current page.north west) rectangle ([yshift=-12.05cm]current page.north east);
  \draw[white,opacity=.15,line width=.8pt] ([xshift=12.7cm,yshift=-2.5cm]current page.north west) circle (5.15cm);
  \draw[white,opacity=.12,line width=.8pt] ([xshift=12.7cm,yshift=-2.5cm]current page.north west) circle (5.95cm);
  \fill[CourseTeal] ([xshift=18.55cm,yshift=-8.25cm]current page.north west) circle (4.25cm);
  \fill[orange!80!CourseAmber] ([xshift=18.2cm,yshift=-7.1cm]current page.north west) circle (.38cm);
  \node[anchor=north west,text width=15.5cm,align=left] at ([xshift=2.8cm,yshift=-2.25cm]current page.north west) {\color{white}\sffamily\large\CourseEyebrow};
  \node[anchor=north west,text width=14.1cm,align=left,inner sep=0pt] at ([xshift=4.2cm,yshift=-6.6cm]current page.north west) {\color{white}\sffamily\bfseries\fontsize{29}{36}\selectfont \CourseTitleTop\\[.1em]\CourseTitleBottom};
  \node[anchor=north west,text width=14.5cm,align=left] at ([xshift=2.8cm,yshift=-10.4cm]current page.north west) {\color{white}\sffamily\large\CourseSubtitle};
  % The three-step curriculum route, printed on every cover.
  \node[draw=CourseBorder,rounded corners=2pt,fill=CourseSoftBlue,minimum width=3.1cm,minimum height=1.28cm,align=center,font=\sffamily\normalsize] (c1) at ([xshift=7.7cm,yshift=-15.55cm]current page.north west) {\CourseRouteA};
  \node[draw=CourseBorder,rounded corners=2pt,fill=CourseSoftBlue,minimum width=3.1cm,minimum height=1.28cm,align=center,font=\sffamily\normalsize] (c2) at ([xshift=11.45cm,yshift=-15.55cm]current page.north west) {\CourseRouteB};
  \node[draw=CourseBorder,rounded corners=2pt,fill=CourseSoftBlue,minimum width=3.1cm,minimum height=1.28cm,align=center,font=\sffamily\normalsize] (c3) at ([xshift=15.2cm,yshift=-15.55cm]current page.north west) {\CourseRouteC};
  \draw[-{Latex[length=2.3mm]},CourseTeal,line width=.9pt] (c1.east) -- (c2.west);
  \draw[-{Latex[length=2.3mm]},CourseTeal,line width=.9pt] (c2.east) -- (c3.west);
  \node[draw=CourseBorder,rounded corners=7pt,fill=CourseSoftBlue,text width=16cm,inner xsep=0.36cm,inner ysep=0.36cm,anchor=north west,align=left] at ([xshift=2cm,yshift=-18.2cm]current page.north west) {\CoursePromise};
  \node[anchor=north west,text width=16.2cm,align=left] at ([xshift=2cm,yshift=-26.65cm]current page.north west) {\color{CourseNavy}\sffamily\large\CourseFooter\\[.35em]{\small\normalfont\color{CourseMuted}\CourseEdition}};
\end{tikzpicture}
\null\end{titlepage}\clearpage
}

% ---- Reusable content components with fixed visual tokens. ----
\newtcolorbox{questionbox}[1][黑板题 / 章节例题]{
  enhanced,breakable,colback=white,colframe=CourseTeal,boxrule=.72pt,
  arc=2mm,title={#1},colbacktitle=CourseTeal,coltitle=white,
  fonttitle=\sffamily\bfseries,top=2mm,bottom=2.5mm,left=3mm,right=3mm,
  before skip=0.8em,after skip=0.85em
}
\newtcolorbox{whybox}[1][为什么这样做？]{
  enhanced,breakable,colback=CourseSoftBlue,colframe=CourseBorder,boxrule=.5pt,
  arc=2mm,title={#1},colbacktitle=CourseNavy,coltitle=white,
  fonttitle=\sffamily\bfseries,top=2mm,bottom=2mm,left=3mm,right=3mm,
  before skip=0.8em,after skip=0.85em
}
\newtcolorbox{takeawaybox}[1][抓住这一点]{
  enhanced,breakable,colback=CourseSoftAmber,colframe=CourseAmber,boxrule=.65pt,
  arc=2mm,title={#1},colbacktitle=CourseAmber,coltitle=white,
  fonttitle=\sffamily\bfseries,top=2mm,bottom=2mm,left=3mm,right=3mm,
  before skip=0.8em,after skip=0.85em
}
\newtcolorbox{trybox}[1][暂停 30 秒：自己试试]{
  enhanced,breakable,colback=CourseSoftBlue,colframe=CourseBorder,boxrule=.55pt,
  arc=2mm,title={#1},colbacktitle=CourseTeal,coltitle=white,
  fonttitle=\sffamily\bfseries,top=2mm,bottom=2mm,left=3mm,right=3mm,
  before skip=0.8em,after skip=0.85em
}
\newtcolorbox{trapbox}[1][常见错误]{
  enhanced,breakable,colback=CourseSoftAmber,colframe=CourseAmber,boxrule=.6pt,
  arc=2mm,title={#1},colbacktitle=CourseAmber,coltitle=white,
  fonttitle=\sffamily\bfseries,top=2mm,bottom=2mm,left=3mm,right=3mm,
  before skip=0.8em,after skip=0.85em
}
\newcommand{\stephead}[1]{\par\medskip\noindent{\bfseries\color{CourseNavy}#1}\enspace}
\newcommand{\teacherhint}[1]{\textcolor{CourseMuted}{\small\sffamily 提示：#1}}
\newcommand{\proofdone}{\hfill\ensuremath{\square}}
\newcommand{\learninggoal}[1]{\begin{takeawaybox}[学完这一部分，你应该能]\noindent #1\end{takeawaybox}}
