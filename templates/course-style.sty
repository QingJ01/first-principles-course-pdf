% First Principles Course PDF -- locked visual system (v1.0)
% XeLaTeX + ctex; font files are NOT bundled. MIT License.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{course-style}[2026/10/22 First principles course design system]
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{graphicx,geometry,xcolor,tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{booktabs,array,enumitem}
\RequirePackage{fancyhdr,titlesec}
\RequirePackage{hyperref}
\RequirePackage{setspace}
\usetikzlibrary{calc,arrows.meta}

% ---- Fonts: require these widely available Noto CJK faces. ----
\setCJKmainfont{Noto Serif CJK SC}
\setCJKsansfont{Noto Sans CJK SC}
\setmainfont{Liberation Serif}
\setsansfont{Liberation Sans}
\setmonofont{Liberation Mono}

% ---- Reproduce the 26-page guide's visual language. ----
\definecolor{CourseNavy}{HTML}{193B54}
\definecolor{CourseTeal}{HTML}{167F87}
\definecolor{CourseAmber}{HTML}{B9873C}
\definecolor{CourseSoftAmber}{HTML}{FFF6E6}
\definecolor{CourseSoftBlue}{HTML}{F0F6F8}
\definecolor{CourseBorder}{HTML}{C9DEE3}
\definecolor{CourseInk}{HTML}{28313B}
\definecolor{CourseMuted}{HTML}{5B6876}
\color{CourseInk}
\geometry{a4paper,left=1.95cm,right=1.95cm,top=1.95cm,bottom=2.15cm,headheight=17pt,headsep=10pt,footskip=1.1cm}
\setstretch{1.28}
\setlength{\parindent}{2em}
\setlength{\parskip}{0.38em}
\emergencystretch=2em
\setlist[itemize]{leftmargin=2em,itemsep=0.16em,topsep=0.3em}
\setlist[enumerate]{leftmargin=2em,itemsep=0.2em,topsep=0.3em}
\setlength{\abovedisplayskip}{0.7em}
\setlength{\belowdisplayskip}{0.7em}
\setlength{\abovedisplayshortskip}{0.4em}
\setlength{\belowdisplayshortskip}{0.5em}

% ---- Changeable text, unchangeable geometry and palette ----
\newcommand{\CourseSubject}{学科课程}
\newcommand{\CourseTopic}{章节专题}
\newcommand{\CourseEyebrow}{数学基础重建・系统课程讲义}
\newcommand{\CourseTitleTop}{从第一性原理学会}
\newcommand{\CourseTitleBottom}{这一章的核心知识}
\newcommand{\CourseSubtitle}{从“完全不会”到能独立解决典型题}
\newcommand{\CourseRouteA}{直觉与\基础}
\newcommand{\CourseRouteB}{定义与\推导}
\newcommand{\CourseRouteC}{例题与\迁移}
\newcommand{\CoursePromise}{\textbf{这份讲义有三项承诺：}不把定理当魔法；每一步都说清楚“为什么”；例题后有独立练习和详解。}
\newcommand{\CourseFooter}{关键概念・第一性原理推导・错误辨析・分层自测}
\newcommand{\CourseEdition}{学习版 · 2026 年}

\titleformat{\section}[hang]{\color{CourseTeal}\sffamily\bfseries\Large}{\thesection}{0.75em}{}
\titleformat{\subsection}[hang]{\color{CourseTeal}\sffamily\bfseries\large}{\thesubsection}{0.58em}{}
\titleformat{\subsubsection}[hang]{\color{CourseNavy}\sffamily\bfseries\normalsize}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.8em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.55em}
\titlespacing*{\subsubsection}{0pt}{0.85em}{0.3em}
\hypersetup{colorlinks=true,linkcolor=CourseTeal,urlcolor=CourseTeal,bookmarksnumbered=true}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\sffamily\color{CourseNavy}\CourseSubject\,・从零开始}
\fancyhead[R]{\footnotesize\sffamily\color{CourseTeal}\CourseTopic}
\fancyfoot[C]{\footnotesize\color{CourseMuted}\thepage}
\renewcommand{\headrulewidth}{0.35pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{CourseMuted}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0pt}

